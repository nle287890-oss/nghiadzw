<button class="btn music" id="music" type="button" aria-pressed="false">Bật nhạc</button>
<audio id="song" src="nhac.mp3" preload="none" loop></audio>

<script>
(function () {
  var yes = document.getElementById("yes");
  var no = document.getElementById("no");
  var counter = document.getElementById("counter");
  var ask = document.getElementById("ask");
  var result = document.getElementById("result");
  var stars = document.getElementById("stars");
  var plan = document.getElementById("plan");
  var msg = document.getElementById("msg");
  var copy = document.getElementById("copy");
  var copied = document.getElementById("copied");
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var noTexts = ["Để sau", "Bận hả?", "Đi mà, tôi đợi", "Tôi chờ được mà", "Chỉ một buổi thôi", "Bấm nút bên kia đi", "Tôi mua đồ uống nha"];
  var tries = 0;
  var yesScale = 1;

  function pick(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : "";
  }

  function spawn() {
    var s = document.createElement("span");
    s.className = "star";
    s.textContent = Math.random() > 0.5 ? "✦" : "✧";
    s.style.left = Math.random() * 100 + "%";
    s.style.fontSize = 12 + Math.random() * 20 + "px";
    s.style.animationDuration = 7 + Math.random() * 6 + "s";
    s.style.animationDelay = Math.random() * 1.5 + "s";
    stars.appendChild(s);
    setTimeout(function () { if (s.parentNode) s.parentNode.removeChild(s); }, 15000);
  }

  var ambient = null;
  if (!reduce) {
    for (var i = 0; i < 6; i++) spawn();
    ambient = setInterval(spawn, 2000);
  }

  function dodge(e) {
    if (e && e.preventDefault) e.preventDefault();
    tries += 1;
    no.textContent = noTexts[Math.min(tries, noTexts.length - 1)];
    counter.textContent = "Số lần bạn từ chối: " + tries;
    yesScale = Math.min(1.5, yesScale + 0.07);
    yes.style.transform = "scale(" + yesScale + ")";

    var pad = 12;
    var w = no.offsetWidth;
    var h = no.offsetHeight;
    var maxX = Math.max(pad, window.innerWidth - w - pad);
    var maxY = Math.max(pad, window.innerHeight - h - pad);
    var yr = yes.getBoundingClientRect();
    var x, y, guard = 0;
    do {
      x = pad + Math.random() * (maxX - pad);
      y = pad + Math.random() * (maxY - pad);
      guard += 1;
    } while (guard < 25 && x < yr.right + 8 && x + w > yr.left - 8 && y < yr.bottom + 8 && y + h > yr.top - 8);

    no.classList.add("flying");
    no.style.left = x + "px";
    no.style.top = y + "px";
  }

  no.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") dodge(e); });
  no.addEventListener("pointerdown", dodge);
  no.addEventListener("click", dodge);
  no.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") dodge(e); });

  yes.addEventListener("click", function () {
    var place = pick("place");
    var when = pick("when");
    no.hidden = true;
    ask.hidden = true;
    result.hidden = false;
    plan.innerHTML = "Mình sẽ <b>" + place + "</b> vào <b>" + when + "</b>.";
    msg.textContent = "Chốt rồi nha, " + when + " mình " + place + ". Nhớ đi đúng giờ đó!";
    if (!reduce) {
      for (var i = 0; i < 30; i++) spawn();
    }
  });

  copy.addEventListener("click", function () {
    var text = msg.textContent;
    function fallback() {
      var range = document.createRange();
      range.selectNodeContents(msg);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      copied.textContent = "Đã chọn sẵn tin nhắn, bạn giữ để chép nhé.";
    }
    try {
      navigator.clipboard.writeText(text).then(function () {
        copied.textContent = "Đã chép. Bạn dán gửi tôi nhé.";
      }, fallback);
    } catch (err) { fallback(); }
  });
  /* Nhạc: ưu tiên file nhac.mp3 đặt cạnh file html; không có thì phát giai điệu lo-fi tự tạo. */
  var musicBtn = document.getElementById("music");
  var song = document.getElementById("song");
  var ctx = null, master = null, timer = null, step = 0, nextT = 0, mode = "";
  var chords = [[220, 261.63, 329.63], [174.61, 220, 261.63], [261.63, 329.63, 392], [196, 246.94, 293.66]];
  var eighth = 60 / 76 / 2;

  function tone(freq, t, dur, type, vol) {
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type; o.frequency.value = freq;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(vol, t + 0.04);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(master);
    o.start(t); o.stop(t + dur + 0.05);
  }

  function schedule() {
    while (nextT < ctx.currentTime + 0.6) {
      var bar = Math.floor(step / 8) % 4, pos = step % 8, c = chords[bar];
      if (pos === 0) c.forEach(function (f) { tone(f, nextT, eighth * 8, "triangle", 0.035); });
      if (pos === 0 || pos === 4) tone(c[0] / 2, nextT, eighth * 3.5, "sine", 0.1);
      tone(c[[0, 1, 2, 1, 2, 1, 0, 2][pos]] * 2, nextT, eighth * 1.8, "sine", 0.05);
      nextT += eighth; step += 1;
    }
  }

  function startSynth() {
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return false;
    if (!ctx) {
      ctx = new AC();
      master = ctx.createGain(); master.gain.value = 0.8;
      var lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 1800;
      master.connect(lp); lp.connect(ctx.destination);
    }
    ctx.resume();
    nextT = ctx.currentTime + 0.1;
    timer = setInterval(schedule, 200);
    schedule();
    return true;
  }

  function setOn(on) {
    musicBtn.setAttribute("aria-pressed", on ? "true" : "false");
    musicBtn.textContent = on ? "Tắt nhạc" : "Bật nhạc";
  }

  function stopMusic() {
    song.pause();
    if (timer) { clearInterval(timer); timer = null; }
    if (ctx) ctx.suspend();
    mode = ""; setOn(false);
  }

  function startMusic() {
    if (mode) return;
    var p;
    try { p = song.play(); } catch (err) { p = null; }
    if (p && p.then) {
      p.then(function () { mode = "file"; setOn(true); }, function () {
        if (!mode && startSynth()) { mode = "synth"; setOn(true); }
      });
    } else if (startSynth()) { mode = "synth"; setOn(true); }
  }

  musicBtn.addEventListener("click", function () {
    if (mode) stopMusic(); else startMusic();
  });

  /* Màn mở đầu: trái tim và hai lựa chọn; chọn "Đi" mới vào trang chính. */
  var intro = document.getElementById("intro");
  var goYes = document.getElementById("goYes");
  var goNo = document.getElementById("goNo");
  var goCounter = document.getElementById("goCounter");
  var shell = [document.querySelector("header.nav"), document.querySelector("main"), document.querySelector("footer")];
  var goTexts = ["Không đi", "Chắc chưa?", "Nghĩ lại đi", "Tôi đợi mà", "Bấm Đi đi mà", "Chỉ một buổi thôi"];
  var goTries = 0, goScale = 1;
  shell.forEach(function (el) { if (el) el.setAttribute("inert", ""); });
  document.body.style.overflow = "hidden";

  function goDodge(e) {
    if (e && e.preventDefault) e.preventDefault();
    goTries += 1;
    goNo.textContent = goTexts[Math.min(goTries, goTexts.length - 1)];
    goCounter.textContent = "Số lần bạn từ chối: " + goTries;
    goScale = Math.min(1.5, goScale + 0.08);
    goYes.style.transform = "scale(" + goScale + ")";
    var pad = 12, w = goNo.offsetWidth, h = goNo.offsetHeight;
    var maxX = Math.max(pad, window.innerWidth - w - pad);
    var maxY = Math.max(pad, window.innerHeight - h - pad);
    var yr = goYes.getBoundingClientRect();
    var x, y, guard = 0;
    do {
      x = pad + Math.random() * (maxX - pad);
      y = pad + Math.random() * (maxY - pad);
      guard += 1;
    } while (guard < 25 && x < yr.right + 8 && x + w > yr.left - 8 && y < yr.bottom + 8 && y + h > yr.top - 8);
    goNo.classList.add("flying");
    goNo.style.left = x + "px";
    goNo.style.top = y + "px";
  }
  goNo.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") goDodge(e); });
  goNo.addEventListener("pointerdown", goDodge);
  goNo.addEventListener("click", goDodge);
  goNo.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") goDodge(e); });

  goYes.addEventListener("click", function () {
    startMusic();
    intro.classList.add("gone");
    setTimeout(function () {
      intro.hidden = true;
      shell.forEach(function (el) { if (el) el.removeAttribute("inert"); });
      document.body.style.overflow = "";
      window.scrollTo(0, 0);
    }, 500);
    if (!reduce) for (var i = 0; i < 25; i++) spawn();
  });

  /* Trình duyệt chặn tự phát tiếng: thử phát ngay khi vào trang (chỉ được với file nhac.mp3 nếu trình duyệt cho phép),
     không được thì phát ở lần chạm hoặc bấm phím đầu tiên bất kỳ đâu trên trang. */
  var gestureDone = false;
  function onFirstGesture(e) {
    if (gestureDone) return;
    gestureDone = true;
    ["pointerdown", "touchstart", "keydown"].forEach(function (n) { document.removeEventListener(n, onFirstGesture, true); });
    if (e && e.target && (e.target === musicBtn || musicBtn.contains(e.target))) return;
    startMusic();
  }
  ["pointerdown", "touchstart", "keydown"].forEach(function (n) { document.addEventListener(n, onFirstGesture, true); });

  try {
    var auto = song.play();
    if (auto && auto.then) auto.then(function () { if (!mode) { mode = "file"; setOn(true); } }, function () {});
  } catch (err) {}
})();
</script>

