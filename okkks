<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Cuối Tuần Đi Đâu</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Lobster&display=swap">
<style>
/* Layout: website một trang, nền đêm xanh và điểm nhấn hổ phách: thanh menu dính, hero, lịch trình một buổi tối, lý do, form chốt kèo (nút "Để sau" né tay), hỏi nhanh. */
:root {
  --bg: #101a2b;
  --bg-2: #15233a;
  --glow: #243a5c;
  --card: #182640;
  --edge: #2e4670;
  --fg: #f3f6fc;
  --muted: #a9b9d4;
  --accent: #ffb347;
  --accent-ink: #2a1a00;
  --chip: #213558;
  --ghost: #26395c;
  --heart: #ff6b81;
  --font-display: "Lobster", "Be Vietnam Pro", cursive, sans-serif;
  --font-body: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  line-height: 1.65;
  overflow-x: hidden;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: var(--bg); }
.wrap {
  width: 100%;
  max-width: 62rem;
  margin-inline: auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
header.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--bg); border-bottom: 1px solid var(--edge); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.75rem; flex-wrap: wrap; }
.brand { font-family: var(--font-display); font-size: 1.4rem; color: var(--accent); text-decoration: none; }
.nav nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
.nav a.link { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
.nav a.link:hover { color: var(--fg); }
a:focus-visible, button:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }

.hero {
  background: radial-gradient(circle at 70% 20%, var(--glow), var(--bg) 62%);
  padding-block: clamp(3rem, 10vw, 6rem);
}
.hero .wrap { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: center; }
.kicker { margin: 0 0 0.75rem; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
h1 { margin: 0 0 1rem; font-family: var(--font-display); font-weight: 400; font-size: clamp(2.4rem, 8vw, 4.2rem); line-height: 1.1; text-wrap: balance; }
h2 { margin: 0 0 0.5rem; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.8rem, 5vw, 2.5rem); line-height: 1.2; text-wrap: balance; }
.lead { margin: 0 0 1.5rem; color: var(--muted); max-width: 34rem; text-wrap: pretty; }
.btn {
  display: inline-block; font: inherit; font-weight: 600; border: 0; border-radius: 999px;
  padding: 0.85rem 1.75rem; cursor: pointer; text-decoration: none; background: var(--accent); color: var(--accent-ink);
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn:hover { background: #ffc468; }
.btn.ghost { background: var(--ghost); color: var(--fg); }
.btn.ghost:hover { background: #31497a; }
.ticket {
  background: var(--card); border: 1px solid var(--edge); border-radius: 1.25rem; padding: 1.5rem;
  box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35); min-width: 0;
}
.ticket dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 1rem; }
.ticket dt { color: var(--muted); font-size: 0.85rem; }
.ticket dd { margin: 0; font-weight: 500; text-align: right; }
.ticket .stamp { margin: 0 0 1rem; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

section.block { padding-block: clamp(2.5rem, 8vw, 4.5rem); }
section.alt { background: var(--bg-2); }
.sub { margin: 0 0 2rem; color: var(--muted); max-width: 34rem; }

.timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
.timeline li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding-block: 1rem; border-top: 1px solid var(--edge); }
.timeline li:last-child { border-bottom: 1px solid var(--edge); }
.timeline time { font-variant-numeric: tabular-nums; color: var(--accent); font-weight: 600; }
.timeline h3 { margin: 0 0 0.15rem; font-size: 1.05rem; }
.timeline p { margin: 0; color: var(--muted); }

.reasons { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
.reason { background: var(--card); border: 1px solid var(--edge); border-radius: 1rem; padding: 1.25rem; min-width: 0; }
.reason h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
.reason p { margin: 0; color: var(--muted); }

.form { background: var(--card); border: 1px solid var(--edge); border-radius: 1.25rem; padding: clamp(1.25rem, 5vw, 2rem); max-width: 40rem; }
fieldset { border: 0; margin: 0 0 1.25rem; padding: 0; min-width: 0; }
legend { padding: 0; margin: 0 0 0.6rem; font-size: 0.9rem; color: var(--muted); }
.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.chips input { position: absolute; opacity: 0; pointer-events: none; }
.chips label { display: inline-block; padding: 0.55rem 1rem; border-radius: 999px; background: var(--chip); border: 1px solid var(--edge); cursor: pointer; font-size: 0.95rem; transition: background 0.15s ease; }
.chips input:checked + label { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
.chips input:focus-visible + label { outline: 3px solid var(--fg); outline-offset: 2px; }
.actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; min-height: 4rem; }
#no.flying { position: fixed; z-index: 40; transition: left 0.18s ease, top 0.18s ease; }
.counter { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; min-height: 1.3em; }
.plan { margin: 0 0 1rem; padding: 1rem 1.1rem; border-radius: 0.9rem; background: var(--chip); border: 1px solid var(--edge); }
.plan b { color: var(--accent); font-weight: 600; }
.msg { margin: 0 0 1rem; padding: 0.9rem 1rem; border-radius: 0.9rem; background: var(--bg); border: 1px dashed var(--edge); user-select: all; }
.form [hidden] { display: none !important; }

details { border-top: 1px solid var(--edge); padding-block: 0.9rem; }
details:last-of-type { border-bottom: 1px solid var(--edge); }
summary { cursor: pointer; font-weight: 500; }
summary:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
details p { margin: 0.5rem 0 0; color: var(--muted); }

footer { padding-block: 2rem; border-top: 1px solid var(--edge); color: var(--muted); font-size: 0.9rem; text-align: center; }

.stars { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 1; }
.star { position: absolute; bottom: -2rem; color: var(--accent); opacity: 0; animation: rise linear forwards; line-height: 1; }
@keyframes rise {
  0% { transform: translateY(0) rotate(-10deg); opacity: 0; }
  12% { opacity: 0.55; }
  100% { transform: translateY(-115vh) rotate(14deg); opacity: 0; }
}
main, header, footer { position: relative; z-index: 2; }

.intro {
  position: fixed; inset: 0; z-index: 100;
  background: radial-gradient(circle at 50% 35%, var(--glow), var(--bg) 68%);
  background-color: var(--bg);
  display: grid; place-items: center; text-align: center; overflow: hidden;
  padding-block: calc(1.5rem + env(safe-area-inset-top, 0px)) calc(1.5rem + env(safe-area-inset-bottom, 0px));
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  transition: opacity 0.5s ease;
}
.intro.gone { opacity: 0; pointer-events: none; }
.intro[hidden] { display: none !important; }
.intro-inner { width: 100%; max-width: 26rem; min-width: 0; }
.big-heart {
  width: min(62vw, 14rem); margin: 0 auto 1.25rem; color: var(--heart);
  filter: drop-shadow(0 1rem 2rem rgba(255, 107, 129, 0.35));
  animation: beat 1.3s ease-in-out infinite;
}
.big-heart svg { display: block; width: 100%; height: auto; fill: currentColor; }
@keyframes beat { 0%, 60%, 100% { transform: scale(1); } 30% { transform: scale(1.08); } }
.intro .actions { justify-content: center; }
#goNo.flying { position: fixed; z-index: 110; transition: left 0.18s ease, top 0.18s ease; }

.music {
  position: fixed; z-index: 50;
  right: max(16px, env(safe-area-inset-right, 0px));
  bottom: calc(16px + env(safe-area-inset-bottom, 0px));
  background: var(--accent); color: var(--accent-ink);
  box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.45);
}
.music[aria-pressed="true"] { background: var(--ghost); color: var(--fg); border: 1px solid var(--edge); }

@media (max-width: 40rem) {
  .hero .wrap { grid-template-columns: minmax(0, 1fr); }
  .timeline li { grid-template-columns: 3.6rem 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .star { animation-duration: 0.01s !important; }
  #no.flying, #goNo.flying, .btn, .chips label, .intro { transition: none; }
  .big-heart { animation: none; }
}
</style>

<div class="stars" id="stars" aria-hidden="true"></div>

<section class="intro" id="intro" aria-label="Câu hỏi mở đầu">
  <div class="intro-inner">
    <div class="big-heart" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
    </div>
    <p class="kicker">Một câu hỏi nhanh</p>
    <h1>Thứ Sáu 04/12, đi chơi nhé, bạn tôi?</h1>
    <div class="actions">
      <button class="btn" id="goYes" type="button">Đi</button>
      <button class="btn ghost" id="goNo" type="button">Không đi</button>
    </div>
    <p class="counter" id="goCounter" aria-live="polite"></p>
  </div>
</section>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top">Cuối tuần đi đâu</a>
    <nav aria-label="Menu">
      <a class="link" href="#lich-trinh">Lịch trình</a>
      <a class="link" href="#ly-do">Lý do</a>
